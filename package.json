{
  "name": "ai-expense-tracker-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade AI Powered Expense Tracker & Personal Finance App Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm --prefix apps/server run dev",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "build:server": "npm --prefix apps/server run build",
    "build:shared": "npm --prefix packages/shared run build",
    "type-check": "npm --prefix packages/shared run type-check && npm --prefix apps/server run type-check",
    "test:nlp": "python apps/server/src/nlp/extract_nlp.py --test",
    "test:sms": "python apps/server/src/nlp/extract_sms.py --test"
  },
  "keywords": [
    "expense-tracker",
    "react-native",
    "expo",
    "express",
    "supabase",
    "python-nlp",
    "ai",
    "finance"
  ],
  "author": "Kartik Halkude",
  "license": "MIT"
}
