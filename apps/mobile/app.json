{
  "expo": {
    "name": "Smart Expense Tracker AI",
    "slug": "ai-expense-tracker",
    "scheme": "aiexpensetracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",

    "assetBundlePatterns": [
      "**/*"
    ],

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "READ_SMS",
        "RECEIVE_SMS"
      ]
    },

    "plugins": [
      "expo-router"
    ]
  }
}